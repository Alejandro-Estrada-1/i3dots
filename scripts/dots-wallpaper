#!/usr/bin/env bash
# Wallpaper manager combining Nitrogen and Pywal (bound to Alt + W).
#
# Usage:
#   dots-wallpaper                 open Nitrogen GUI (repo wallpapers + ~/Imágenes),
#                                  then auto-sync Pywal on exit
#   dots-wallpaper <image_path>    set wallpaper via Nitrogen and update Pywal
#   dots-wallpaper --random        pick a random wallpaper and update Pywal
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck source=lib/common.sh
source "$REPO/scripts/lib/common.sh"

case "${1:-}" in
    --random)
        exec "$REPO/scripts/dots-pywal" --random
        ;;
    "")
        # Single picker instance: pressing Alt + W again closes the open picker
        exec 9>"${XDG_RUNTIME_DIR:-/tmp}/dots-wallpaper.lock"
        if ! flock -n 9; then
            pkill -f '^nitrogen$' 2>/dev/null || true
            exit 0
        fi

        saved="$DOTS_CONFIG/nitrogen/bg-saved.cfg"
        stamp() { stat -c '%.9Y %s %i' "$saved" 2>/dev/null || echo none; }
        before="$(nitrogen_current_wallpaper)"
        before_stamp="$(stamp)"

        # Open Nitrogen (browsing every folder from nitrogen.cfg) to pick a wallpaper.
        # Nitrogen 1.6 never closes by itself:
        #   - Enter / double-click only *previews* (sets the root pixmap, no save)
        #   - "Apply" saves bg-saved.cfg but keeps the window open
        # So: watch root-pixmap property events (xprop -spy prints one line per
        # set, even when the pixmap id is reused); on a preview, press Nitrogen's
        # own Apply (Alt+A) so it saves; once bg-saved.cfg changes, close it.
        sync_nitrogen_dirs
        spy_log="${XDG_RUNTIME_DIR:-/tmp}/dots-wallpaper-spy.$$"
        : >"$spy_log"
        spy_pid=""
        if command -v xprop >/dev/null; then
            xprop -root -spy _XROOTPMAP_ID >"$spy_log" 2>/dev/null 9>&- &
            spy_pid=$!
        fi
        trap 'rm -f "$spy_log"; [[ -n "$spy_pid" ]] && kill "$spy_pid" 2>/dev/null; true' EXIT

        nitrogen >/dev/null 2>&1 9>&- &
        nitrogen_pid=$!
        sleep 0.3
        seen=$(wc -l <"$spy_log")   # first line = current value, not a preview
        (( seen > 0 )) || seen=1
        while kill -0 "$nitrogen_pid" 2>/dev/null; do
            if [[ "$(stamp)" != "$before_stamp" ]]; then
                sleep 0.2   # let Nitrogen finish writing the file
                kill "$nitrogen_pid" 2>/dev/null || true
                break
            fi
            events=$(wc -l <"$spy_log")
            if (( events > seen )) && command -v xdotool >/dev/null; then
                seen=$events
                win=$(xdotool search --pid "$nitrogen_pid" --onlyvisible 2>/dev/null | head -n 1 || true)
                if [[ -n "$win" ]]; then
                    xdotool windowactivate --sync "$win" key --clearmodifiers alt+a 2>/dev/null || true
                fi
            fi
            sleep 0.25
        done
        wait "$nitrogen_pid" 2>/dev/null || true
        exec 9>&-

        after="$(nitrogen_current_wallpaper)"
        after_stamp="$(stamp)"

        if [[ -f "$after" && ( "$after" != "$before" || "$after_stamp" != "$before_stamp" ) ]]; then
            "$REPO/scripts/dots-pywal" --image "$after"
            command -v notify-send >/dev/null && notify-send "i3dots · Nitrogen + Pywal" "$(basename "$after")" || true
        fi
        ;;
    *)
        img="$(readlink -f "$1")"
        [[ -f "$img" ]] || { echo "File not found: $1" >&2; exit 1; }
        nitrogen --set-zoom-fill --save "$img" >/dev/null 2>&1
        "$REPO/scripts/dots-pywal" --image "$img"
        command -v notify-send >/dev/null && notify-send "i3dots · Nitrogen + Pywal" "$(basename "$img")" || true
        ;;
esac
