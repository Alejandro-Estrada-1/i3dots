#!/usr/bin/env bash
# Volume, mute and brightness keys (bound in config/i3/config) with:
#   - 50 ms flock debounce (prevents duplicate WMI hotkey events on laptops)
#   - Minimalist Pywal-styled Dunst OSD toast with live progress bar
#
# Usage: dots-mediakey volume-up | volume-down | mute | mic-mute | brightness-up | brightness-down
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck source=lib/common.sh
source "$REPO/scripts/lib/common.sh"

# Hardware backlight (laptops) via brightnessctl; desktops / external monitors
# without one fall back to software brightness with `xrandr --brightness`.
has_backlight() { compgen -G "/sys/class/backlight/*" >/dev/null && command -v brightnessctl >/dev/null; }
SOFT_BRIGHT_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/i3dots/brightness"

soft_brightness() { # delta (e.g. +5 / -5) -> applies to every connected output
    local delta=$1 cur out
    mkdir -p "$(dirname "$SOFT_BRIGHT_FILE")"
    cur=$(cat "$SOFT_BRIGHT_FILE" 2>/dev/null || echo 100)
    [[ "$cur" =~ ^[0-9]+$ ]] || cur=100
    cur=$(( cur + delta ))
    (( cur > 100 )) && cur=100
    (( cur < 20 ))  && cur=20
    echo "$cur" >"$SOFT_BRIGHT_FILE"
    while read -r out; do
        xrandr --output "$out" --brightness "$(awk -v p="$cur" 'BEGIN{printf "%.2f", p/100}')" 2>/dev/null || true
    done < <(xrandr --query | awk '/ connected/{print $1}')
}

action=${1:-}
case "$action" in
    volume-up)       cmd=(wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+) ;;
    volume-down)     cmd=(wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-) ;;
    mute)            cmd=(wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle) ;;
    mic-mute)        cmd=(wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle) ;;
    brightness-up)   if has_backlight; then cmd=(brightnessctl -q s 2%+); else cmd=(soft_brightness +5); fi ;;
    brightness-down) if has_backlight; then cmd=(brightnessctl -q s 2%-); else cmd=(soft_brightness -5); fi ;;
    *) sed -n '6p' "$0" | sed 's/^# //' >&2; exit 1 ;;
esac

dir="${XDG_RUNTIME_DIR:-/tmp}/dots-mediakey"
mkdir -p "$dir"
stamp="$dir/$action"

exec 9>"$stamp.lock"
flock 9
now=$(date +%s%N)
last=$(cat "$stamp" 2>/dev/null || echo 0)
(( now - last < 50000000 )) && exit 0
echo "$now" >"$stamp"
"${cmd[@]}"

# --- Minimalist Pywal OSD toast via dunstify ---
notify_osd() { # tag id title body [value]
    local tag=$1 id=$2 title=$3 body=$4 val=${5:-}
    command -v dunstify >/dev/null || return 0
    if [[ -n "$val" ]]; then
        dunstify -a "i3dots-osd" -u low -t 1500 -r "$id" \
            -h "string:x-dunst-stack-tag:$tag" \
            -h "int:value:$val" \
            "$title" "$body" >/dev/null 2>&1 || true
    else
        dunstify -a "i3dots-osd" -u low -t 1500 -r "$id" \
            -h "string:x-dunst-stack-tag:$tag" \
            "$title" "$body" >/dev/null 2>&1 || true
    fi
}

case "$action" in
    volume-up|volume-down|mute)
        info=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)
        pct=$(awk '{printf "%d", ($2 * 100) + 0.5}' <<<"$info")
        bar_val=$(( pct > 100 ? 100 : pct ))
        if [[ "$info" == *"[MUTED]"* ]]; then
            notify_osd "osd-volume" 9101 "󰝟  $(L "Volume" "Volumen")" "$(L "Muted" "Silenciado") ($pct%)" 0
        else
            icon=""
            (( pct == 0 )) && icon="" || { (( pct < 50 )) && icon=""; }
            notify_osd "osd-volume" 9101 "$icon  $(L "Volume" "Volumen")" "$pct%" "$bar_val"
        fi
        ;;
    mic-mute)
        info=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || true)
        if [[ "$info" == *"[MUTED]"* ]]; then
            notify_osd "osd-mic" 9102 "󰍭  $(L "Microphone" "Micrófono")" "$(L "Muted" "Silenciado")"
        else
            notify_osd "osd-mic" 9102 "󰍬  $(L "Microphone" "Micrófono")" "$(L "Active" "Activo")"
        fi
        ;;
    brightness-up|brightness-down)
        if has_backlight; then
            cur=$(brightnessctl g 2>/dev/null || echo 0)
            max=$(brightnessctl m 2>/dev/null || echo 1)
            pct=$(( max > 0 ? (cur * 100 + max / 2) / max : 0 ))
        else
            pct=$(cat "$SOFT_BRIGHT_FILE" 2>/dev/null || echo 100)
        fi
        notify_osd "osd-brightness" 9104 "  $(L "Brightness" "Brillo")" "$pct%" "$pct"
        ;;
esac
