#!/usr/bin/env bash
# Applies X11 keyboard layout, key repeat rate and flat pointer acceleration
# from ~/.config/i3dots/settings (mirrors Hyprland modules/input.lua).
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck source=lib/common.sh
source "$REPO/scripts/lib/common.sh"

[[ -n "${DISPLAY:-}" ]] || exit 0

kb_layout=$(dots_setting kb_layout "us")
kb_variant=$(dots_setting kb_variant "")
kb_options=$(dots_setting kb_options "")

if command -v setxkbmap >/dev/null; then
    args=(-layout "$kb_layout" -option "")
    [[ -n "$kb_variant" ]] && args+=(-variant "$kb_variant")
    [[ -n "$kb_options" ]] && args+=(-option "$kb_options")
    setxkbmap "${args[@]}" 2>/dev/null || true
fi

# Crisp key repeat rate (delay 200ms, rate 50Hz — matches Hyprland input.lua)
if command -v xset >/dev/null; then
    xset r rate 200 50 2>/dev/null || true
fi

# Apply flat acceleration profile to pointer devices when supported
if command -v xinput >/dev/null; then
    while IFS= read -r id; do
        [[ -n "$id" ]] || continue
        xinput --set-prop "$id" "libinput Accel Profile Enabled" 0, 1 2>/dev/null || true
    done < <(xinput list --id-only 2>/dev/null || true)
fi
