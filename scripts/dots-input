#!/usr/bin/env bash
# Applies X11 keyboard layout, key repeat rate, laptop touchpad tap-to-click
# and flat pointer acceleration from ~/.config/i3dots/settings.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck source=lib/common.sh
source "$REPO/scripts/lib/common.sh"

[[ -n "${DISPLAY:-}" ]] || exit 0

kb_layout=$(dots_setting kb_layout "us")
kb_variant=$(dots_setting kb_variant "")
kb_options=$(dots_setting kb_options "")

if command -v setxkbmap >/dev/null; then
    args=(-layout "$kb_layout" -option "")
    [[ -n "$kb_variant" ]] && args+=(-variant "$kb_variant")
    [[ -n "$kb_options" ]] && args+=(-option "$kb_options")
    setxkbmap "${args[@]}" 2>/dev/null || true
fi

# Crisp key repeat rate (delay 200ms, rate 50Hz — matches Hyprland input.lua)
if command -v xset >/dev/null; then
    xset r rate 200 50 2>/dev/null || true
fi

# Pointer & laptop touchpad ergonomics via xinput / libinput
if command -v xinput >/dev/null; then
    while IFS= read -r id; do
        [[ -n "$id" ]] || continue
        props=$(xinput list-props "$id" 2>/dev/null || true)
        # Flat acceleration profile for mice/pointers
        if grep -q "libinput Accel Profile Enabled" <<<"$props"; then
            xinput --set-prop "$id" "libinput Accel Profile Enabled" 0, 1 2>/dev/null || true
        fi
        # Touchpad: enable tap-to-click, tap-and-drag and disable-while-typing;
        # keep standard scroll direction (matches Hyprland natural_scroll = false)
        if grep -q "libinput Tapping Enabled (" <<<"$props"; then
            xinput --set-prop "$id" "libinput Tapping Enabled" 1 2>/dev/null || true
            xinput --set-prop "$id" "libinput Tapping Drag Enabled" 1 2>/dev/null || true
            xinput --set-prop "$id" "libinput Disable While Typing Enabled" 1 2>/dev/null || true
            xinput --set-prop "$id" "libinput Natural Scrolling Enabled" 0 2>/dev/null || true
        fi
    done < <(xinput list --id-only 2>/dev/null || true)
fi
