#!/usr/bin/env bash
# Bluetooth status icon for Polybar right island (matches the badge icon in the
# reference screenshots). Supports `dots-bluetooth toggle` on right-click.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck source=lib/common.sh
source "$REPO/scripts/lib/common.sh"

# bluetoothctl blocks forever when there is no controller/daemon: always time-box it
bt() { timeout 2 bluetoothctl "$@" 2>/dev/null; }
has_controller() { compgen -G "/sys/class/bluetooth/hci*" >/dev/null && command -v bluetoothctl >/dev/null; }

if [[ "${1:-}" == "toggle" ]]; then
    if has_controller; then
        if bt show | grep -q "Powered: yes"; then
            bt power off >/dev/null || true
        else
            bt power on >/dev/null || true
        fi
    fi
    exit 0
fi

accent="#7b9391"
muted="#576c6e"
if [[ -r "$WAL_CACHE/polybar-colors.ini" ]]; then
    a=$(sed -n 's/^accent[[:space:]]*=[[:space:]]*//p' "$WAL_CACHE/polybar-colors.ini" | head -n 1)
    m=$(sed -n 's/^muted[[:space:]]*=[[:space:]]*//p' "$WAL_CACHE/polybar-colors.ini" | head -n 1)
    [[ -n "$a" ]] && accent="$a"
    [[ -n "$m" ]] && muted="$m"
fi

if has_controller && bt show | grep -q "Powered: yes"; then
    printf '%%{T2}%%{F%s}%%{F-}%%{T-}\n' "$accent"
else
    printf '%%{T2}%%{F%s}󰂲%%{F-}%%{T-}\n' "$muted"
fi
