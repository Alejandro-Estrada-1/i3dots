#!/usr/bin/env bash
# Rofi power menu adapted to X11 / i3 (bound to Alt + Z).
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck source=lib/common.sh
source "$REPO/scripts/lib/common.sh"

ensure_wal_fallbacks

rasi="$DOTS_CONFIG/rofi/powermenu.rasi"
uptime_str="$(uptime -p | sed -e 's/up //g')"

shutdown='⏼'
reboot='󰜉'
lock=''
suspend=''
logout='󰿅'
yes=''
no=''

rofi_cmd() {
    rofi -dmenu \
        -p "$(L "Uptime" "Encendido"): $uptime_str" \
        -mesg "$(L "Uptime" "Encendido"): $uptime_str" \
        -theme "$rasi"
}

confirm_cmd() {
    rofi -theme-str 'window {location: center; anchor: center; width: 320px;}' \
        -theme-str 'mainbox {children: [ "message", "listview" ];}' \
        -theme-str 'listview {columns: 2; lines: 1;}' \
        -theme-str 'element-text {horizontal-align: 0.5;}' \
        -theme-str 'textbox {horizontal-align: 0.5;}' \
        -dmenu \
        -p "$(L "Confirmation" "Confirmación")" \
        -mesg "$(L "Are you sure?" "¿Estás seguro?")" \
        -theme "$rasi"
}

confirm_exit() {
    printf '%s\n%s\n' "$yes" "$no" | confirm_cmd || true
}

run_rofi() {
    printf '%s\n%s\n%s\n%s\n%s\n' "$lock" "$suspend" "$logout" "$reboot" "$shutdown" | rofi_cmd || true
}

confirm_or_exit() {
    local selected
    selected="$(confirm_exit)"
    [[ "$selected" == "$yes" ]] || exit 0
}

chosen="$(run_rofi)"
[[ -n "$chosen" ]] || exit 0

case "$chosen" in
    "$shutdown")
        confirm_or_exit
        systemctl poweroff
        ;;
    "$reboot")
        confirm_or_exit
        systemctl reboot
        ;;
    "$lock")
        confirm_or_exit
        "$REPO/scripts/dots-lock"
        ;;
    "$suspend")
        confirm_or_exit
        playerctl pause 2>/dev/null || true
        wpctl set-mute @DEFAULT_AUDIO_SINK@ 1 >/dev/null 2>&1 || true
        "$REPO/scripts/dots-lock" &
        sleep 0.3
        systemctl suspend
        ;;
    "$logout")
        confirm_or_exit
        i3-msg exit
        ;;
esac
