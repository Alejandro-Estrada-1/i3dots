#!/usr/bin/env bash
# Audio visualizer for the Polybar "module/cava" module (adapted from the
# Hyprland Waybar dots-cava script for X11 / multi-monitor Polybar).
#
# Runs cava with raw ASCII output and maps every frame to 8 Unicode block bars
# (▁▂▃▄▅▆▇█). Bars animate smoothly while audio plays and stay flat in silence.
set -euo pipefail

bars="▁▂▃▄▅▆▇█"
config="${XDG_RUNTIME_DIR:-/tmp}/dots-cava-$$.conf"
trap 'rm -f "$config"; pkill -P $$ 2>/dev/null || true' EXIT TERM INT

cat >"$config" <<EOF
[general]
framerate = 60
autosens = 1
bars = 8
lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[input]
method = pulse
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7
bar_delimiter = 59
frame_delimiter = 10
channels = mono
mono_option = average
reverse = 0

[smoothing]
monstercat = 1
waves = 1
noise_reduction = 77
EOF

# "0;3;7;..." -> "▁▄█..."; drop anything that is not a numeric frame
script="/^[0-9;]*$/!d;s/;//g;"
for i in {0..7}; do script+="s/$i/${bars:$i:1}/g;"; done
flat="${bars:0:1}${bars:0:1}${bars:0:1}${bars:0:1}${bars:0:1}${bars:0:1}${bars:0:1}${bars:0:1}"

audio_ready() {
    if command -v pactl >/dev/null; then
        pactl info >/dev/null 2>&1
    else
        [[ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/pulse/native" ]]
    fi
}

command -v cava >/dev/null || { echo "$flat"; exit 0; }

# Wait for PipeWire/PulseAudio at login and recover cleanly if audio restarts.
# Exit immediately once Polybar closes our stdout pipe (SIGPIPE).
while :; do
    until audio_ready; do
        echo "$flat" 2>/dev/null || exit 0
        sleep 2
    done
    env --default-signal=PIPE cava -p "$config" 2>/dev/null |
        env --default-signal=PIPE sed -u "$script" || true
    echo "$flat" 2>/dev/null || exit 0
    sleep 2
done
