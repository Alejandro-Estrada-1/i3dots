#!/usr/bin/python3
"""Floating X11 / i3 MPRIS media center panel (dots-media).

Ported from the Hyprland GTK4 layer-shell panel to native X11 / GTK3 so it
positions accurately right above the bottom-right Polybar island with true RGBA
transparency (blurred by picom dual-kawase) and Pywal dynamic colors.

Features:
  - Single-instance D-Bus toggle: running again (SUPER + P or Polybar icon) closes it.
  - Also closes on Esc or when clicking outside (focus loss).
  - One tab per active MPRIS player (Spotify, Brave, VLC, etc.).
  - Center-cropped square album art with async download + disk cache & placeholder.
  - Title, artist, source, live progress bar + timestamps, prev / play-pause / next.
"""

import hashlib
import os
import threading
import time
import urllib.request

import cairo
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Playerctl", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango, Playerctl  # noqa: E402

CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
CACHE_HOME = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
ART_CACHE_DIR = os.path.join(CACHE_HOME, "dots-media")

# Nerd Font glyphs (written as escapes so editors cannot drop them)
ICON_MUSIC = "\U000F075A"
ICON_PREV = "\U000F04AE"
ICON_PLAY = "\U000F040A"
ICON_PAUSE = "\U000F03E4"
ICON_NEXT = "\U000F04AD"

ART_SIZE = 84
BAR_CLEARANCE = 40  # 26px bar + 6px bottom offset + 8px breathing gap


def interface_language():
    """Language chosen in install.sh (~/.config/i3dots/settings)."""
    try:
        with open(os.path.join(CONFIG_HOME, "i3dots", "settings"), encoding="utf-8") as f:
            for line in f:
                if line.startswith("language="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return "en"


LANG = interface_language()


def L(en, es):
    return es if LANG == "es" else en


def format_time(microseconds):
    seconds = max(0, int(microseconds // 1_000_000))
    return f"{seconds // 60}:{seconds % 60:02d}"


def pretty_name(player):
    name = player.props.player_name or "?"
    return name[:1].upper() + name[1:]


class MediaPanel(Gtk.Application):
    def __init__(self):
        GLib.set_prgname("dots-media")
        super().__init__(application_id="io.github.i3dots.MediaPanel")
        self.window = None
        self.manager = None
        self.selected = None
        self.art_url = None
        self.opened_at = 0.0

    # A second launch reaches the running instance via D-Bus: toggle closed
    def do_activate(self):
        if self.window is not None:
            self.quit()
            return
        self.opened_at = time.monotonic()
        self.load_css()
        self.build_window()
        self.setup_players()
        self.refresh()
        GLib.timeout_add_seconds(1, self.tick)
        self.window.show_all()
        # Re-apply conditional visibility after show_all()
        self.refresh()
        GLib.idle_add(self.position_window)

    # ---------- CSS (Pywal + fallback) ----------
    def load_css(self):
        wal_colors = os.path.join(CACHE_HOME, "wal", "dots-media.css")
        fallback_colors = os.path.join(CONFIG_HOME, "dots-media", "colors.css")
        style_path = os.path.join(CONFIG_HOME, "dots-media", "style.css")

        parts = []
        for path in (wal_colors if os.path.exists(wal_colors) else fallback_colors, style_path):
            try:
                with open(path, encoding="utf-8") as f:
                    parts.append(f.read())
            except OSError:
                pass

        if not parts:
            return
        provider = Gtk.CssProvider()
        provider.load_from_data("\n".join(parts).encode("utf-8"))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1
        )

    # ---------- Window & Layout ----------
    def build_window(self):
        win = Gtk.ApplicationWindow(application=self)
        win.set_title("dots-media")
        win.set_wmclass("dots-media", "dots-media")
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)
        win.set_keep_above(True)
        win.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        win.get_style_context().add_class("dots-media")

        # True RGBA transparency for picom frosted-glass dual-kawase blur
        screen = win.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None and screen.is_composited():
            win.set_visual(visual)
            win.set_app_paintable(True)
            win.connect("draw", self.on_draw)

        self.panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.panel.get_style_context().add_class("panel")
        win.add(self.panel)

        self.tabs = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.tabs.get_style_context().add_class("tabs")
        self.panel.pack_start(self.tabs, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_vhomogeneous(False)
        self.stack.set_interpolate_size(True)
        self.panel.pack_start(self.stack, True, True, 0)

        empty = Gtk.Label(label=f"{ICON_MUSIC}  {L('Nothing playing', 'Nada reproduciéndose')}")
        empty.get_style_context().add_class("empty")
        self.stack.add_named(empty, "empty")

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        art_frame = Gtk.Box()
        art_frame.set_size_request(ART_SIZE, ART_SIZE)
        art_frame.get_style_context().add_class("art-frame")
        self.art = Gtk.Image()
        self.art.set_size_request(ART_SIZE, ART_SIZE)
        self.art_placeholder = Gtk.Label(label=ICON_MUSIC)
        self.art_placeholder.set_size_request(ART_SIZE, ART_SIZE)
        self.art_placeholder.get_style_context().add_class("art-placeholder")
        self.art_stack = Gtk.Stack()
        self.art_stack.add_named(self.art_placeholder, "placeholder")
        self.art_stack.add_named(self.art, "art")
        art_frame.pack_start(self.art_stack, True, True, 0)
        top.pack_start(art_frame, False, False, 0)

        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        info.set_valign(Gtk.Align.CENTER)
        self.title = Gtk.Label(xalign=0)
        self.title.set_ellipsize(Pango.EllipsizeMode.END)
        self.title.set_max_width_chars(24)
        self.title.get_style_context().add_class("title")

        self.artist = Gtk.Label(xalign=0)
        self.artist.set_ellipsize(Pango.EllipsizeMode.END)
        self.artist.set_max_width_chars(26)
        self.artist.get_style_context().add_class("artist")

        self.source = Gtk.Label(xalign=0)
        self.source.get_style_context().add_class("source")

        for widget in (self.title, self.artist, self.source):
            info.pack_start(widget, False, False, 0)
        top.pack_start(info, True, True, 0)
        card.pack_start(top, False, False, 0)

        self.progress = Gtk.ProgressBar()
        self.progress.get_style_context().add_class("progress")
        card.pack_start(self.progress, False, False, 0)

        self.times_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.position = Gtk.Label(xalign=0)
        self.length = Gtk.Label(xalign=1)
        for widget in (self.position, self.length):
            widget.get_style_context().add_class("time")
        self.times_box.pack_start(self.position, True, True, 0)
        self.times_box.pack_end(self.length, False, False, 0)
        card.pack_start(self.times_box, False, False, 0)

        controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        controls.set_halign(Gtk.Align.CENTER)
        controls.get_style_context().add_class("controls")
        self.play_button = None
        for icon, action in ((ICON_PREV, "previous"), (ICON_PLAY, "play_pause"), (ICON_NEXT, "next")):
            button = Gtk.Button(label=icon)
            button.get_style_context().add_class("control")
            button.connect("clicked", self.on_control, action)
            controls.pack_start(button, False, False, 0)
            if action == "play_pause":
                self.play_button = button
        card.pack_start(controls, False, False, 0)

        self.stack.add_named(card, "player")

        win.connect("key-press-event", self.on_key)
        win.connect("focus-out-event", self.on_focus_out)
        win.connect("size-allocate", lambda *_: self.position_window())
        win.connect("map-event", lambda *_: (self.position_window(), False)[1])
        win.connect("destroy", lambda *_: self.quit())
        self.window = win

    @staticmethod
    def on_draw(widget, cr):
        cr.save()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0.0, 0.0, 0.0, 0.0)
        cr.paint()
        cr.restore()
        return False

    def position_window(self):
        if self.window is None:
            return False
        display = Gdk.Display.get_default()
        if display is None:
            return False

        # Anchor above the bottom-right Polybar island on the active monitor
        monitor = None
        seat = display.get_default_seat()
        if seat is not None:
            pointer = seat.get_pointer()
            if pointer is not None:
                _, px, py = pointer.get_position()
                monitor = display.get_monitor_at_point(px, py)
        if monitor is None:
            monitor = display.get_primary_monitor() or display.get_monitor(0)
        if monitor is None:
            return False

        geom = monitor.get_geometry()
        alloc = self.window.get_allocation()
        width = max(alloc.width, 372)
        height = max(alloc.height, 64)
        margin_right = max(16, int(geom.width * 0.01))

        x = geom.x + geom.width - width - margin_right
        y = geom.y + geom.height - height - BAR_CLEARANCE
        self.window.move(x, y)
        gdk_win = self.window.get_window()
        if gdk_win is not None:
            gdk_win.move(x, y)
        return False

    def on_key(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.quit()
            return True
        return False

    def on_focus_out(self, widget, event):
        # Short grace period prevents X11/i3 map jitter from closing immediately
        if time.monotonic() - self.opened_at < 0.2:
            return False
        self.quit()
        return False

    # ---------- MPRIS Players ----------
    def setup_players(self):
        self.manager = Playerctl.PlayerManager()
        self.manager.connect("name-appeared", lambda manager, name: (self.add_player(name), self.refresh()))
        self.manager.connect("player-vanished", lambda manager, player: self.refresh())
        for name in self.manager.props.player_names:
            self.add_player(name)

    def add_player(self, name):
        try:
            player = Playerctl.Player.new_from_name(name)
        except GLib.Error:
            return
        player.connect("playback-status", lambda *_: self.refresh())
        player.connect("metadata", lambda *_: self.refresh())
        self.manager.manage_player(player)

    def players(self):
        return list(self.manager.props.players) if self.manager else []

    def on_control(self, button, action):
        if self.selected is None:
            return
        try:
            getattr(self.selected, action)()
        except GLib.Error:
            pass

    def select(self, player):
        self.selected = player
        self.refresh()

    def refresh(self):
        players = self.players()
        if self.selected not in players:
            playing = [p for p in players if p.props.playback_status == Playerctl.PlaybackStatus.PLAYING]
            self.selected = (playing or players or [None])[0]

        for child in list(self.tabs.get_children()):
            self.tabs.remove(child)

        for player in players:
            tab = Gtk.Button(label=pretty_name(player))
            tab.get_style_context().add_class("tab")
            if player == self.selected:
                tab.get_style_context().add_class("active")
            tab.connect("clicked", lambda button, p=player: self.select(p))
            self.tabs.pack_start(tab, False, False, 0)
            tab.show()
        self.tabs.set_visible(len(players) > 1)

        if self.selected is None:
            self.stack.set_visible_child_name("empty")
            GLib.idle_add(self.position_window)
            return False

        self.stack.set_visible_child_name("player")
        player = self.selected
        self.title.set_label(self.safe(player.get_title) or L("Unknown title", "Título desconocido"))
        artist = self.safe(player.get_artist) or ""
        self.artist.set_label(artist)
        self.artist.set_visible(bool(artist))
        self.source.set_label(pretty_name(player))
        playing = player.props.playback_status == Playerctl.PlaybackStatus.PLAYING
        self.play_button.set_label(ICON_PAUSE if playing else ICON_PLAY)
        self.set_art(self.safe(lambda: player.print_metadata_prop("mpris:artUrl")) or "")
        self.tick()
        GLib.idle_add(self.position_window)
        return False

    @staticmethod
    def safe(getter):
        try:
            return getter()
        except GLib.Error:
            return None

    def tick(self):
        if self.window is None:
            return False
        player = self.selected
        length = 0
        if player is not None:
            try:
                length = int(player.print_metadata_prop("mpris:length") or 0)
            except (GLib.Error, ValueError):
                length = 0
        if player is None or length <= 0:
            self.progress.set_visible(False)
            self.times_box.set_visible(False)
            return True
        position = self.safe(player.get_position) or 0
        self.progress.set_visible(True)
        self.times_box.set_visible(True)
        self.progress.set_fraction(min(1.0, max(0.0, position / length)))
        self.position.set_label(format_time(position))
        self.length.set_label(format_time(length))
        return True

    # ---------- Album Art ----------
    def set_art(self, url):
        if url == self.art_url:
            return
        self.art_url = url
        if url.startswith("file://"):
            self.show_art(Gio.File.new_for_uri(url).get_path())
        elif url.startswith(("http://", "https://")):
            path = os.path.join(ART_CACHE_DIR, hashlib.sha1(url.encode()).hexdigest())
            if os.path.exists(path):
                self.show_art(path)
            else:
                self.art_stack.set_visible_child_name("placeholder")
                threading.Thread(target=self.download_art, args=(url, path), daemon=True).start()
        else:
            self.art_stack.set_visible_child_name("placeholder")

    def download_art(self, url, path):
        try:
            os.makedirs(ART_CACHE_DIR, exist_ok=True)
            with urllib.request.urlopen(url, timeout=5) as response:
                data = response.read()
            with open(path, "wb") as f:
                f.write(data)
        except OSError:
            return
        GLib.idle_add(lambda: self.show_art(path) if url == self.art_url else None)

    def show_art(self, path):
        """Center-crops the album art to a square and scales it smoothly."""
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
            side = min(pixbuf.get_width(), pixbuf.get_height())
            square = pixbuf.new_subpixbuf(
                (pixbuf.get_width() - side) // 2,
                (pixbuf.get_height() - side) // 2,
                side,
                side,
            )
            scaled = square.scale_simple(ART_SIZE, ART_SIZE, GdkPixbuf.InterpType.BILINEAR)
            self.art.set_from_pixbuf(scaled)
            self.art_stack.set_visible_child_name("art")
        except (GLib.Error, TypeError):
            self.art_stack.set_visible_child_name("placeholder")
        return False


if __name__ == "__main__":
    MediaPanel().run(None)
