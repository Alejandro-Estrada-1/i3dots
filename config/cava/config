# ==============================================================================
# Cava Audio Visualizer Configuration — i3dots
# ==============================================================================
# Wide clean vertical bars matching Image 4's frosted terminal equalizer.
# The [color] section at the bottom is updated automatically by dots-pywal.

[general]
framerate = 60
autosens = 1
sensitivity = 100
bars = 0
bar_width = 4
bar_spacing = 2
lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[input]
method = pipewire
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo
show_idle_bar_heads = 1

[smoothing]
monstercat = 1
waves = 0
noise_reduction = 77

# --- PYWAL_COLORS_BEGIN ---
[color]
gradient = 1
gradient_count = 4
gradient_color_1 = '#475b5e'
gradient_color_2 = '#6e8c8a'
gradient_color_3 = '#879f9d'
gradient_color_4 = '#cdd8d5'
# --- PYWAL_COLORS_END ---
