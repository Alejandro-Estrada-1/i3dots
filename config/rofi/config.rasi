/* ============================================================================
 * Rofi Launcher Theme — i3dots (Frosted Glass + 1px Border + Pywal)
 * ============================================================================
 * Matches the 3-island bottom Polybar aesthetic: dark translucent glass,
 * crisp 1px light border, subtle 3px corner radius, JetBrainsMono Nerd Font.
 */

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    display-drun:        "";
    display-run:         "";
    display-window:      "";
    drun-display-format: "{name}";
    font:                "JetBrainsMono Nerd Font 10";
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}

@import "~/.cache/wal/rofi-colors.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    location:         center;
    anchor:           center;
    width:            520px;
    border:           1px solid;
    border-color:     @border;
    border-radius:    3px;
    background-color: @bg;
    padding:          14px;
}

mainbox {
    spacing:          12px;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    spacing:          10px;
    padding:          8px 12px;
    border:           1px solid;
    border-color:     @muted;
    border-radius:    3px;
    background-color: @bg-alt;
    children:         [ "prompt", "entry" ];
}

prompt {
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font 12";
}

entry {
    placeholder:       "Search...";
    placeholder-color: @muted;
    text-color:        @fg;
    cursor:            text;
}

listview {
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          4px;
    fixed-height:     false;
}

element {
    spacing:          10px;
    padding:          7px 10px;
    border-radius:    3px;
    cursor:           pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg-solid;
}

element-icon {
    size:             20px;
    cursor:           inherit;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
    cursor:           inherit;
}
