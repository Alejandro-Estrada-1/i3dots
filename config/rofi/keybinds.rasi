/* Rofi Keybinds Cheatsheet — i3dots (Frosted Glass + 1px Border + Pywal) */
@import "~/.cache/wal/rofi-colors.rasi"

* {
    font:             "JetBrainsMono Nerd Font 9.5";
    background-color: transparent;
    text-color:       @fg;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    location:         center;
    anchor:           center;
    width:            680px;
    border:           1px solid;
    border-color:     @border;
    border-radius:    3px;
    background-color: @bg;
    padding:          14px;
}

mainbox {
    spacing:          10px;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    spacing:          10px;
    padding:          8px 12px;
    border:           1px solid;
    border-color:     @muted;
    border-radius:    3px;
    background-color: @bg-alt;
    children:         [ "prompt", "entry" ];
}

prompt {
    text-color:       @accent;
}

entry {
    placeholder:       "Filter...";
    placeholder-color: @muted;
    text-color:        @fg;
}

listview {
    columns:          1;
    lines:            14;
    cycle:            true;
    scrollbar:        false;
    spacing:          3px;
}

element {
    padding:          6px 10px;
    border-radius:    3px;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg-solid;
}

element-text {
    text-color:       inherit;
}
