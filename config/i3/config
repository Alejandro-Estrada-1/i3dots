# ==============================================================================
# i3 Window Manager Configuration — i3dots (Arch Linux + Polybar + Nitrogen + Pywal)
# ==============================================================================
# Inherited ergonomics from Hyprland dotfiles:
#   - Exact keybindings (SUPER + B = Brave, WASD focus, 1-5 laptop / 6-10 HDMI)
#   - Multi-monitor laptop (left) + HDMI external (right) via dots-monitors
#   - Floating X11 media center panel (SUPER + P -> dots-media)
# Visual design:
#   - Crisp 2px Pywal borders (Xresources), 0px corners, 8px inner / 6px outer gaps
#   - 36px bottom gap reserving clean room for the 3-island floating bottom Polybar

set $mod Mod4
set $alt Mod1
set $bin ~/.local/bin

# --- Typography ---
font pango:JetBrainsMono Nerd Font 10

# --- Pywal Colors (loaded from Xresources merged by dots-pywal) ---
# Fallback palette matches the default alpine mountain-lake wallpaper
set_from_resource $bg       i3wm.background #0c171b
set_from_resource $fg       i3wm.foreground #cdd8d5
set_from_resource $color0   i3wm.color0     #0c171b
set_from_resource $color1   i3wm.color1     #5a7879
set_from_resource $color2   i3wm.color2     #6e8c8a
set_from_resource $color4   i3wm.color4     #7b9491
set_from_resource $color7   i3wm.color7     #cdd8d5
set_from_resource $color8   i3wm.color8     #475b5e

# class                 border   backgr.  text     indicator child_border
client.focused          $fg      $bg      $fg      $color4   $fg
client.focused_inactive $color8  $bg      $color7  $color8   $color8
client.unfocused        $color8  $bg      $color8  $color8   $color8
client.urgent           $color1  $color1  $fg      $color1   $color1
client.placeholder      $color0  $bg      $fg      $color0   $color0
client.background       $bg

# --- Borders & Gaps ---
# Sharp rectangular frames with thin 2px borders matching the reference screenshots
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders none
focus_follows_mouse yes
mouse_warping output

gaps inner 8
gaps outer 6
# Extra bottom space for the floating 3-island bottom Polybar (height 26 + offset 6)
gaps bottom 36

# --- Floating Window Mouse Modifier ---
# SUPER + Left click = drag floating window, SUPER + Right click = resize
floating_modifier $mod

# ==============================================================================
# KEYBINDS — Programs & Utilities
# ==============================================================================
# @bind Change theme / Pywal menu | Alt + C
bindsym $alt+c exec --no-startup-id $bin/dots-pywal --menu
# @bind Change wallpaper (Nitrogen + Pywal) | Alt + W
bindsym $alt+w exec --no-startup-id $bin/dots-wallpaper
# @bind Open terminal (Kitty) | Alt + Enter
bindsym $alt+Return exec --no-startup-id kitty
# @bind Open file manager (Thunar) | Super + E
bindsym $mod+e exec --no-startup-id thunar
# @bind Open application menu (Rofi) | Alt + X
bindsym $alt+x exec --no-startup-id rofi -show drun
# @bind Open power menu | Alt + Z
bindsym $alt+z exec --no-startup-id $bin/dots-powermenu
# @bind Open browser (Brave) | Super + B
bindsym $mod+b exec --no-startup-id brave
# @bind Clipboard history (Rofi) | Super + V
bindsym $mod+v exec --no-startup-id $bin/dots-clipboard
# @bind Media panel | Super + P
bindsym $mod+p exec --no-startup-id $bin/dots-media
# @bind Show notification history | Super + N
bindsym $mod+n exec --no-startup-id dunstctl history-pop
# @bind Close all notifications | Super + Shift + N
bindsym $mod+Shift+n exec --no-startup-id dunstctl close-all
# @bind Open calculator | XF86Calculator
bindsym XF86Calculator exec --no-startup-id kcalc
# @bind Take a screenshot | Print
bindsym Print exec --no-startup-id flameshot gui -c
# @bind Lock screen | Super + L
bindsym $mod+l exec --no-startup-id $bin/dots-lock
# @bind Close the bar | Super + K
bindsym $mod+k exec --no-startup-id $bin/dots-polybar hide
# @bind Open the bar | Super + J
bindsym $mod+j exec --no-startup-id $bin/dots-polybar show
# @bind Show keybinds cheatsheet | Super + Shift + K
bindsym $mod+Shift+k exec --no-startup-id $bin/dots-keybinds
# @bind Refresh monitors and reload i3 | Super + Shift + R
bindsym $mod+Shift+r exec --no-startup-id $bin/dots-monitors --reload

# ==============================================================================
# KEYBINDS — Window Management
# ==============================================================================
# @bind Close active window | Alt + Q
bindsym $alt+q kill
# @bind Exit i3 | Super + M
bindsym $mod+m exit
# @bind Toggle fullscreen | Super + F
bindsym $mod+f fullscreen toggle
# @bind Toggle floating window | Alt + F
bindsym $alt+f floating toggle
# @bind Toggle split layout | Alt + S
bindsym $alt+s layout toggle split
# @bind Move window to scratchpad | Super + Shift + -
bindsym $mod+Shift+minus move scratchpad
# @bind Toggle scratchpad window | Super + -
bindsym $mod+minus scratchpad show
# @bind Resize window mode (A/D/W/S) | Super + R
bindsym $mod+r mode "resize"

mode "resize" {
    bindsym a resize shrink width 10 px or 5 ppt
    bindsym d resize grow width 10 px or 5 ppt
    bindsym w resize shrink height 10 px or 5 ppt
    bindsym s resize grow height 10 px or 5 ppt
    bindsym Shift+a resize shrink width 30 px or 10 ppt
    bindsym Shift+d resize grow width 30 px or 10 ppt
    bindsym Shift+w resize shrink height 30 px or 10 ppt
    bindsym Shift+s resize grow height 30 px or 10 ppt

    bindsym Left resize shrink width 10 px or 5 ppt
    bindsym Right resize grow width 10 px or 5 ppt
    bindsym Up resize shrink height 10 px or 5 ppt
    bindsym Down resize grow height 10 px or 5 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

# ==============================================================================
# KEYBINDS — Focus & Window Movement (WASD)
# ==============================================================================
# @bind Focus left | Super + A
bindsym $mod+a focus left
# @bind Focus right | Super + D
bindsym $mod+d focus right
# @bind Focus up | Super + W
bindsym $mod+w focus up
# @bind Focus down | Super + S
bindsym $mod+s focus down

# Move focused window with SUPER + SHIFT + WASD
# @bind Move window left | Super + Shift + A
bindsym $mod+Shift+a move left
# @bind Move window right | Super + Shift + D
bindsym $mod+Shift+d move right
# @bind Move window up | Super + Shift + W
bindsym $mod+Shift+w move up
# @bind Move window down | Super + Shift + S
bindsym $mod+Shift+s move down

# ==============================================================================
# KEYBINDS — Workspaces (1-5 Laptop, 6-10 External HDMI)
# ==============================================================================
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspaces 1-5 (Alt + 1..5)
# @bind Go to workspace 1..5 | Alt + 1..5
bindsym $alt+1 workspace number $ws1
bindsym $alt+2 workspace number $ws2
bindsym $alt+3 workspace number $ws3
bindsym $alt+4 workspace number $ws4
bindsym $alt+5 workspace number $ws5

# Switch to workspaces 6-10 (Ctrl + 1..5)
# @bind Go to workspace 6..10 | Ctrl + 1..5
bindsym Control+1 workspace number $ws6
bindsym Control+2 workspace number $ws7
bindsym Control+3 workspace number $ws8
bindsym Control+4 workspace number $ws9
bindsym Control+5 workspace number $ws10

# Move window to workspaces 1-5 (Super + 1..5)
# @bind Move window to workspace 1..5 | Super + 1..5
bindsym $mod+1 move container to workspace number $ws1
bindsym $mod+2 move container to workspace number $ws2
bindsym $mod+3 move container to workspace number $ws3
bindsym $mod+4 move container to workspace number $ws4
bindsym $mod+5 move container to workspace number $ws5

# Move window to workspaces 6-10 (Ctrl + Shift + 1..5)
# @bind Move window to workspace 6..10 | Ctrl + Shift + 1..5
bindsym Control+Shift+1 move container to workspace number $ws6
bindsym Control+Shift+2 move container to workspace number $ws7
bindsym Control+Shift+3 move container to workspace number $ws8
bindsym Control+Shift+4 move container to workspace number $ws9
bindsym Control+Shift+5 move container to workspace number $ws10

# Scroll through workspaces with SUPER + mouse wheel
# @bind Next workspace | Super + Scroll down
bindsym --whole-window $mod+button5 workspace next
# @bind Previous workspace | Super + Scroll up
bindsym --whole-window $mod+button4 workspace prev

# ==============================================================================
# KEYBINDS — Multi-Monitor Navigation (Laptop Left, HDMI Right)
# ==============================================================================
# @bind Focus left monitor | Super + ,
bindsym $mod+comma focus output left
# @bind Focus right monitor | Super + .
bindsym $mod+period focus output right
# @bind Move window to left monitor | Super + Shift + ,
bindsym $mod+Shift+comma move container to output left
# @bind Move window to right monitor | Super + Shift + .
bindsym $mod+Shift+period move container to output right

# Dynamic workspace -> output bindings generated by dots-monitors
include ~/.cache/i3dots/outputs.conf

# ==============================================================================
# KEYBINDS — Media, Volume & Brightness (50ms debounced via dots-mediakey)
# ==============================================================================
# @bind Volume up (+5%) | XF86AudioRaiseVolume
bindsym XF86AudioRaiseVolume exec --no-startup-id $bin/dots-mediakey volume-up
# @bind Volume down (-5%) | XF86AudioLowerVolume
bindsym XF86AudioLowerVolume exec --no-startup-id $bin/dots-mediakey volume-down
# @bind Mute audio | XF86AudioMute
bindsym XF86AudioMute exec --no-startup-id $bin/dots-mediakey mute
# @bind Mute microphone | XF86AudioMicMute
bindsym XF86AudioMicMute exec --no-startup-id $bin/dots-mediakey mic-mute
# @bind Brightness up (+2%) | XF86MonBrightnessUp
bindsym XF86MonBrightnessUp exec --no-startup-id $bin/dots-mediakey brightness-up
# @bind Brightness down (-2%) | XF86MonBrightnessDown
bindsym XF86MonBrightnessDown exec --no-startup-id $bin/dots-mediakey brightness-down

# @bind Next track | XF86AudioNext
bindsym XF86AudioNext exec --no-startup-id playerctl next
# @bind Play / pause | XF86AudioPause / XF86AudioPlay
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
# @bind Previous track | XF86AudioPrev
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# ==============================================================================
# WINDOW RULES
# ==============================================================================
# Media center panel (scripts/dots-media): floating, sticky, undecorated
for_window [class="(?i)dots-media"] floating enable, sticky enable, border none

# Utility dialogs float cleanly
for_window [class="Nitrogen"] floating enable, resize set 820 560, move position center
for_window [class="Pavucontrol"] floating enable, resize set 760 500, move position center
for_window [class="Blueman-manager"] floating enable, resize set 680 460, move position center
for_window [class="Nm-connection-editor"] floating enable, move position center
for_window [class="kcalc"] floating enable, move position center
for_window [class="Arandr"] floating enable, move position center
for_window [class="Lxappearance"] floating enable, move position center
for_window [window_role="pop-up|bubble|task_dialog|Preferences|dialog"] floating enable
for_window [window_type="dialog|menu"] floating enable

# ==============================================================================
# AUTOSTART
# ==============================================================================
# Session environment & authentication agent
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP=i3
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Keyboard layout, repeat rate, laptop touchpad tapping and mouse acceleration
exec_always --no-startup-id $bin/dots-input

# Sequential startup: configure HDMI layout & Nitrogen first, then restore Pywal
# and launch Polybar once (prevents startup race conditions / duplicate bars)
exec --no-startup-id sh -c '$HOME/.local/bin/dots-monitors --init && $HOME/.local/bin/dots-pywal --restore'

# Automatic HDMI hotplug watcher (zero-dependency udevadm DRM listener)
exec --no-startup-id $bin/dots-monitor-watch

# Clipboard history daemon (greenclip)
exec --no-startup-id sh -c 'command -v greenclip >/dev/null && (pgrep -x greenclip >/dev/null || greenclip daemon)'

# Compositor (dual-kawase frosted glass blur) & notifications
exec_always --no-startup-id sh -c 'pgrep -x picom >/dev/null || picom --config ~/.config/picom/picom.conf -b'
exec --no-startup-id sh -c 'pgrep -x dunst >/dev/null || dunst -conf ~/.cache/wal/dunstrc'

# Lock screen on suspend & optional system applets
exec --no-startup-id xss-lock --transfer-sleep-lock -- $bin/dots-lock
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
