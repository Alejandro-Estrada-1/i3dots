# Fallback Dunst configuration (alpine-teal palette).
# Live config is generated at ~/.cache/wal/dunstrc by Pywal.

[global]
    monitor = 0
    follow = mouse
    width = (260, 360)
    height = (0, 220)
    origin = bottom-right
    offset = (16, 44)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 320
    progress_bar_corner_radius = 2

    indicate_hidden = yes
    transparency = 0
    separator_height = 1
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 1
    frame_color = "#8ea09d"
    gap_size = 8
    separator_color = "#576c6e"
    sort = yes

    font = JetBrainsMono Nerd Font 9.5
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    sticky_history = yes
    history_length = 25
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/brave
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 3
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0b1518dc"
    foreground = "#cdd8d5"
    frame_color = "#576c6e"
    highlight = "#7b9391"
    timeout = 4

[urgency_normal]
    background = "#0b1518dc"
    foreground = "#cdd8d5"
    frame_color = "#8ea09d"
    highlight = "#7b9391"
    timeout = 6

[urgency_critical]
    background = "#0b1518ee"
    foreground = "#cdd8d5"
    frame_color = "#b86f6b"
    highlight = "#b86f6b"
    timeout = 0
