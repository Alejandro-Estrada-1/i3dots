{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small",
        "padding": {
            "top": 1,
            "left": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " · "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": " ",
            "keyColor": "36"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "36"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "36"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "36"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "36"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "36"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "36"
        },
        {
            "type": "memory",
            "key": " ",
            "keyColor": "36"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
