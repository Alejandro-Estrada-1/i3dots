/* Generated by Pywal from ~/.config/wal/templates/rofi-colors.rasi */
* {{
    bg:         #{background.strip}dc;
    bg-solid:   {background};
    bg-alt:     #{color0.strip}f0;
    fg:         {foreground};
    accent:     {color6};
    border:     {color7};
    muted:      {color8};
    urgent:     {color1};
}}
